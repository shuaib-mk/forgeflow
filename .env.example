FORGEFLOW_ENV=development
FORGEFLOW_HTTP_ADDR=:8080
FORGEFLOW_DATABASE_URL=postgres://forgeflow:forgeflow@localhost:5432/forgeflow?sslmode=disable
FORGEFLOW_REDIS_URL=redis://localhost:6379/0
FORGEFLOW_SESSION_SECRET=replace-with-at-least-32-random-characters
FORGEFLOW_WORKSPACE_ROOT=./data/workspaces
FORGEFLOW_LOG_LEVEL=info
FORGEFLOW_WORKER_CONCURRENCY=2
FORGEFLOW_ALLOWED_ORIGINS=http://localhost:5173
# Migration files used by the migration command.
FORGEFLOW_MIGRATIONS_DIR=./deployments/migrations
# Base URL used by the opt-in end-to-end test suite.
FORGEFLOW_E2E_URL=http://localhost:8080
